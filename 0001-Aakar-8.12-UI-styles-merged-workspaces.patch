+#wsSubTop button:hover{color:#fff}
+#wsSubTop button.on{color:#fff;border-bottom-color:#ff8a3d}
+body.sk-graphite #wsSubTop,body.sk-pro #wsSubTop{display:flex}
+body.sk-pro #wsSubTop button{font-size:12.5px;font-weight:500;padding:6px 14px;color:#c3c6cd}
+body.sk-pro #wsSubTop button.on{color:#ff8a3d;border-bottom:3px solid #ff7a1a;font-weight:600}
+#wsDrop{flex:none;width:112px;flex-direction:column;align-items:center;justify-content:center;gap:4px;margin-right:4px;border:0;border-right:1px solid #3a3c42;background:none;color:#e6e7ea;cursor:pointer;align-self:stretch}
+#wsDrop:hover{background:#323338}
