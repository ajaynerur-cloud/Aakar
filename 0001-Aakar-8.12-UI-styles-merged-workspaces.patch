+<!--AAKAR-UI-SKINS-START-->
+<style id="aakar-skins-css">
+/* ============ UI style picker (all skins) ============ */
+#skBtn{height:26px;padding:0 10px;margin-left:6px;background:rgba(255,138,61,.12);border:1px solid rgba(255,138,61,.5);border-radius:6px;color:#ffb178;font-size:12px;cursor:pointer;display:flex;align-items:center;gap:6px;white-space:nowrap;flex:none}
+#skBtn:hover{background:rgba(255,138,61,.22)}
+#skBtn svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:1.8}
+#skPop{position:fixed;inset:0;z-index:9000;background:rgba(5,7,10,.62);backdrop-filter:blur(3px);display:none;align-items:center;justify-content:center;font-family:"Segoe UI",system-ui,sans-serif}
+#skPop.open{display:flex}
+#skPop .box{width:min(960px,calc(100vw - 32px));max-height:calc(100vh - 40px);overflow:auto;background:#181a1f;border:1px solid #33363d;border-radius:14px;padding:20px 22px;color:#e6e7ea;box-shadow:0 30px 80px rgba(0,0,0,.6)}
+#skPop h2{margin:0;font-size:18px;font-weight:600}#skPop p.sub{margin:4px 0 16px;color:#9a9da6;font-size:13px}
+#skPop .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
+#skPop .opt{background:#202227;border:2px solid #30333a;border-radius:11px;padding:10px;cursor:pointer;text-align:left;color:inherit;font:inherit;transition:border-color .15s,transform .15s}
+#skPop .opt:hover{border-color:#5a5e68;transform:translateY(-2px)}
+#skPop .opt.on{border-color:#ff8a3d;box-shadow:0 0 0 3px rgba(255,138,61,.18)}
+#skPop .opt b{display:flex;justify-content:space-between;align-items:center;font-size:14px;margin:9px 2px 3px}
+#skPop .opt b i{font-style:normal;font-size:10.5px;font-weight:600;color:#ff8a3d;letter-spacing:.05em}
+#skPop .opt small{display:block;color:#9a9da6;font-size:12px;line-height:1.4;margin:0 2px}
+#skPop .pv{height:120px;border-radius:7px;overflow:hidden;display:grid;grid-template-rows:14px 16px 1fr 10px;border:1px solid #000}
+#skPop .pv .a{display:flex;gap:3px;align-items:center;padding:0 5px}#skPop .pv .a span{height:5px;border-radius:2px}
+#skPop .pv .m{display:grid;grid-template-columns:22% 1fr 20%}
+#skPop .pv .vp{position:relative}#skPop .pv .vp:after{content:"";position:absolute;left:30%;top:28%;width:38%;height:42%;border-radius:2px;background:var(--pm);transform:skewY(-10deg)}
+#skPop .foot{display:flex;justify-content:space-between;align-items:center;margin-top:16px;color:#7a7e88;font-size:12px}
+#skPop .foot button{background:#ff8a3d;color:#1d0f04;border:0;border-radius:7px;padding:7px 18px;font-weight:600;cursor:pointer;font-size:13px}
+
+body.sk-studio #filterbar,body.sk-graphite #filterbar,body.sk-pro #filterbar{flex-wrap:nowrap!important;max-width:calc(100% - 24px)!important}
+body.sk-graphite #x855bar .lbl,body.sk-pro #x855bar .lbl{display:none!important}
+
+/* ============ Merged workspaces (Studio / Graphite / Pro) ============ */
+#wsPills,#wsSubTop,#wsCtx,#wsDrop{display:none}
+body.sk-studio #ribbon,body.sk-graphite #ribbon,body.sk-pro #ribbon{display:none!important}
+#wsPills{gap:2px;background:#0f131a;border:1px solid #262e3d;border-radius:9px;padding:2px;flex:none;margin:0 4px}
+#wsPills button{background:none;border:0;border-radius:6px;padding:3px 11px;font-size:12px;color:#8792a6;cursor:pointer;display:flex;align-items:center;gap:6px;white-space:nowrap}
+#wsPills button i{width:6px;height:6px;border-radius:50%;background:#5d677a}
+#wsPills button:hover{color:#e3e8f1}
+#wsPills button.on{background:#1d2330;color:#fff;box-shadow:0 0 0 1px #2e3748}
