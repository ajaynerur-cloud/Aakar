+#wsDrop .ico svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.6;stroke-linejoin:round}
+#wsDrop .lab{font-size:11px;letter-spacing:.08em;font-weight:700;text-transform:uppercase;white-space:nowrap}
+body.sk-graphite #wsDrop,body.sk-pro #wsDrop{display:flex}
