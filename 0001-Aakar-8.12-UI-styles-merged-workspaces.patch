+body.sk-pro #wsDrop .lab{font-size:13px}
+#wsMenu{position:fixed;z-index:8000;min-width:230px;background:#25262a;border:1px solid #3a3c42;border-radius:9px;padding:5px;box-shadow:0 16px 40px rgba(0,0,0,.55);display:none;font-family:"Segoe UI",system-ui,sans-serif}
+#wsMenu.open{display:block}
+#wsMenu .mh{font-size:10px;letter-spacing:.08em;color:#6c6f78;padding:6px 8px 3px}
+#wsMenu button{display:flex;align-items:center;gap:10px;width:100%;text-align:left;background:none;border:0;color:#e6e7ea;padding:7px 9px;border-radius:5px;cursor:pointer;font-size:13px}
+#wsMenu button:hover{background:rgba(255,138,61,.16)}
+#wsMenu button.on{color:#ff8a3d}
+#wsMenu button small{margin-left:auto;color:#6c6f78;font-size:11px}
+/* ViewCube (added by Graphite + Pro) */
+#skCube{position:absolute;right:14px;top:12px;width:104px;z-index:15;display:none;flex-direction:column;align-items:center;gap:4px;user-select:none}
+#skCube svg{width:96px;height:96px;cursor:pointer;filter:drop-shadow(0 4px 10px rgba(0,0,0,.45))}
+#skCube svg .f{transition:filter .12s}#skCube svg .f:hover{filter:brightness(1.18)}
+#skCube .vb{display:flex;gap:2px;background:rgba(30,32,36,.85);border:1px solid #3a3c42;border-radius:7px;padding:2px}
+#skCube .vb button{width:28px;height:24px;border:0;background:none;color:#a7abb4;border-radius:5px;cursor:pointer;font-size:13px}
+#skCube .vb button:hover{background:#3a3c42;color:#fff}
+body.sk-graphite #skCube,body.sk-pro #skCube{display:flex}
+body.sk-graphite #viewnav,body.sk-pro #viewnav{display:none!important}
